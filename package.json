{
  "name": "a-forja-do-heroi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Forja do Herói — RPG narrativo de navegador no mundo de Icarus",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node scripts/prepare-assets.mjs",
    "sfx": "node scripts/generate-sfx.mjs",
    "sprites": "node scripts/build-sprites.mjs && node scripts/build-battle-sprites.mjs && node scripts/build-items.mjs && node scripts/build-objetos.mjs && node scripts/build-dados.mjs && node scripts/build-icones.mjs",
    "test:unit": "node --test scripts/manter-assets.test.mjs scripts/mapas.test.mjs scripts/lajes.test.mjs",
    "test:mobile": "playwright test",
    "test:parte": "playwright test --grep",
    "test:jogo": "playwright test --project=pixel-7",
    "test:layout": "playwright test --grep @layout"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/kalam": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
